# What EAS Build copies into the build directory (cloud and --local).
# This file replaces .gitignore for EAS, so it repeats those rules and adds
# the ones that keep a build hermetic.

# dependencies and generated output
node_modules/
.expo/
dist/
web-build/
expo-env.d.ts
/ios
/android
/build/
.kotlin/
*.orig.*
.metro-health-check*
*.tsbuildinfo
*.log
.DS_Store

# Environment files. Build values come only from the profile's EAS
# environment; Expo CLI would otherwise load a local .env.production into a
# release bundle.
.env
.env.*
!.env.example

# Signing material: local credentials are read by eas-cli on the host, never
# shipped in the project archive.
credentials.json
credentials/
*.jks
*.keystore
*.p8
*.p12
*.key
*.pem
*.mobileprovision
google-services.json
GoogleService-Info.plist

# pnpm-lock.yaml is the only lockfile; any other one would switch the build
# to a different package manager.
yarn.lock
package-lock.json
bun.lock
bun.lockb
bunfig.toml

# Not part of the app bundle
/docs/
/design_handoff_*/
/supabase/
/tools/
/.github/
example
